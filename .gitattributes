# ═══════════════════════════════════════════════
#   Line Endings - اجباری برای همه
# ═══════════════════════════════════════════════
* text=auto eol=lf

# ═══ کدهای متنی: همیشه LF ═══
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.env.example text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.toml text eol=lf

# ═══ فایل‌های باینری: تغییر نده ═══
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary