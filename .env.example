# ─── Django Core ───
SECRET_KEY='django-insecure-8b!7hmis4j-_r&^waegji#%2hzhucrqfn(672bfc513*=j9!s6'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ───
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# برای PostgreSQL این‌ها را فعال کن:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=project_core
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# ─── Site ───
SITE_NAME=زیبانو
SITE_DOMAIN=http://localhost:8000

# ─── Admin URLs ───
LANDING_ADMIN_URL=landing-admin/
APP_ADMIN_URL=app-admin/
DASHBOARD_ADMIN_URL=dashboard-admin/

# ─── Media & Static ───
