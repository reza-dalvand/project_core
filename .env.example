# ─── Django Core ───
SECRET_KEY='django-insecure-8b!7hmis4j-_r&^waegji#%2hzhucrqfn(672bfc513*=j9!s6'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.zibano.app

# ─── Database ───
DB_ENGINE=django.db.backends.postgresql
DB_NAME=zibano
DB_USER=zibano
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# ─── Site ───
SITE_NAME=زیبانو
SITE_DOMAIN=http://localhost:8000

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── SMS (Kavenegar) ───
KAVENEGAR_API_KEY=your-kavenegar-api-key

# ─── Shahkar (National ID Verification) ───
SHAHKAR_API_URL=https://api.example.com/shahkar/verify
SHAHKAR_API_KEY=your-shahkar-api-key

# ─── Payment (Zibal) ───
ZIBAL_MERCHANT_ID=your-zibal-merchant-id
ZIBAL_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback/

# ─── Storage (Arvan Cloud S3) ───
ARVAN_ACCESS_KEY=your-arvan-access-key
ARVAN_SECRET_KEY=your-arvan-secret-key
ARVAN_BUCKET_NAME=zibano
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_REGION=ir-thr-at1
ARVAN_CDN_URL=

# ─── CORS ───
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Admin URLs ───
LANDING_ADMIN_URL=admin/
APP_ADMIN_URL=app-admin/
DASHBOARD_ADMIN_URL=dashboard-admin/

# ─── Sentry (Production) ───
SENTRY_DSN=

# ─── Media & Static ───
MEDIA_URL=/media/
STATIC_URL=/static/